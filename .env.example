# Base URL of the backend API. Leave empty to run on built-in sample data.
VITE_API_BASE_URL=

# AI drafting for the Report text "Generate" buttons (server side only; never prefix with VITE_).
# Put these in .env.local for `npm run dev`, and in the Vercel project settings when deployed.
# Without a key, Generate drafts from the app's own scan of the uploaded files.
ANTHROPIC_API_KEY=
# Optional team passcode the app asks for once before drafting with AI.
AI_ACCESS_CODE=
